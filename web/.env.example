# AI Agent Configuration
# Development: arahkan ke Ollama lokal (http://localhost:11434/v1)
# Production: arahkan ke URL publik Ollama server via Nginx reverse proxy
AI_API_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_MS=

# Supabase Auth (gates the AI Assistant to signed-in research assistants).
# Both are public/client-safe; leave blank to disable auth (AI stays open).
# Get them from Supabase: Project Settings > API (Project URL + anon public key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
